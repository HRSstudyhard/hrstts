    <!-- 启动权限引导 -->
    <string name="perm_title">权限与联网</string>
    <string name="perm_intro">为完成「导入文本」「下载端侧语音模型」，应用需要以下能力。系统不允许弹窗授予的项目，点按钮会跳到对应设置页，返回后会自动刷新状态。</string>
    <string name="perm_storage_title">存储访问</string>
    <string name="perm_storage_desc">用于直接读写手机上的文本文件。不授权也可用：导入文本走系统文件选择器（SAF），模型存在应用私有目录。</string>
    <string name="perm_network_title">网络</string>
    <string name="perm_network_desc">仅用于下载可选的 Qwen3-TTS 端侧模型（约 1.5 GB）。网络权限在安装时已自动授予，这里检测的是当前是否联网。</string>
    <string name="perm_install_title">安装未知应用</string>
    <string name="perm_install_desc">用于安装应用自身的新版本 APK（Android 8 起需在系统设置中手动开启）。</string>
    <string name="perm_footnote">提示：以上均为可选项，全部跳过也不影响「导入文本 + 系统语音朗读」。</string>
