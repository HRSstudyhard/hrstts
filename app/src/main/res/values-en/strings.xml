    <!-- Startup permission guide -->
    <string name="perm_title">Permissions &amp; network</string>
    <string name="perm_intro">To import text and download the on-device speech model, the app needs the following. Items that cannot be granted by a dialog will open the matching settings page; the state refreshes when you come back.</string>
    <string name="perm_storage_title">Storage access</string>
    <string name="perm_storage_desc">Used to read and write text files on the device directly. Not required: importing uses the system file picker (SAF) and the model lives in app-private storage.</string>
    <string name="perm_network_title">Network</string>
    <string name="perm_network_desc">Only used to download the optional on-device Qwen3-TTS model (about 1.5 GB). The network permission is granted at install time; this checks whether you are online right now.</string>
    <string name="perm_install_title">Install unknown apps</string>
    <string name="perm_install_desc">Used to install a new version of this app itself (a manual toggle in system settings since Android 8).</string>
    <string name="perm_footnote">Note: all of these are optional. Skipping them does not affect importing text and reading with the system voice.</string>
    <string name="perm_done">Done</string>
    <string name="perm_dont_ask">Don\'t ask again</string>
